# ============================================
# AgentHub 配置模板
# 复制为 .env 后按需修改
# ============================================

# ── App ──
APP_NAME=AgentHub
DEBUG=false

# ── Database ──
DATABASE_URL=postgresql://agenthub:agenthub@localhost:5433/agenthub_cp

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Security ──
# 生产环境务必使用强随机字符串
SECRET_KEY=change-me-to-a-256-bit-random-string
JWT_SECRET=change-me-to-a-256-bit-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_URL=http://localhost:3000
SEED_DEV_ACCOUNTS=true
AGENTHUB_DEV_PASSWORD=AgentHub123!

# ── Docker ──
DOCKER_HOST=unix:///var/run/docker.sock
HERMES_IMAGE=agenthub/hermes-base:latest
RUNTIME_PROVIDER=docker
RUNTIME_DOCKER_NETWORK=agenthub_local

# ── Model Proxy ──
MODEL_PROXY_ENABLED=true
# 平台统一代理 OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-...

# ── Frontend ──
VITE_API_BASE_URL=/api

# ── Workspace Storage ──
MINIO_ROOT_USER=agenthub
MINIO_ROOT_PASSWORD=agenthub-secret
WORKSPACE_STORAGE_PROVIDER=minio
WORKSPACE_S3_ENDPOINT=http://minio:9000
WORKSPACE_S3_BUCKET=agenthub-workspaces
WORKSPACE_S3_REGION=us-east-1

# ── Billing ──
# Stripe (Phase 2)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
