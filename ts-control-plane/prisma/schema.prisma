generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  emailVerified Boolean @default(false) @map("email_verified")
  image     String?
  platformRole String @default("user") @map("platform_role")
  isActive  Boolean  @default(true)
  banned    Boolean  @default(false)
  banReason String?  @map("ban_reason")
  banExpires DateTime? @map("ban_expires")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Member[]
  sentInvitations Invitation[]
  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?    @default("{}")
  tier      String   @default("free")
  status    String   @default("active")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   Member[]
  invitations Invitation[]
  instances Instance[]
  projects  Project[]
  tasks     Task[]
  llmProviders LlmProviderConfig[]

  @@map("tenants")
}

model Member {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("members")
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  role      String   @default("member")
  status    String   @default("pending")
  teamId    String?  @map("team_id")
  inviterId String   @map("inviter_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invitations")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  activeOrganizationId String? @map("active_organization_id")
  impersonatedBy String? @map("impersonated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verification")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model LlmProviderConfig {
  id            String    @id @default(uuid())
  tenantId      String?   @map("tenant_id")
  name          String
  provider      String
  baseUrl       String    @map("base_url")
  apiKeyEnc     String    @map("api_key_enc")
  isDefault     Boolean   @default(false) @map("is_default")
  isActive      Boolean   @default(true) @map("is_active")
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("llm_provider_configs")
}

model Instance {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  containerId         String?  @map("container_id")
  containerName       String   @map("container_name")
  status              String   @default("pending")
  runtimeType         String   @default("docker") @map("runtime_type")
  runtimeClass        String   @default("runc") @map("runtime_class")
  desiredStatus       String   @default("running") @map("desired_status")
  observedStatus      String   @default("pending") @map("observed_status")
  health              String   @default("unknown")
  nodeId              String?  @map("node_id")
  clusterId           String?  @map("cluster_id")
  k8sNamespace        String?  @map("k8s_namespace")
  runtimeResourceName String?  @map("runtime_resource_name")
  cpuRequestMillicores Int?    @map("cpu_request_millicores")
  cpuLimitMillicores   Int?    @map("cpu_limit_millicores")
  memoryRequestBytes   BigInt? @map("memory_request_bytes")
  memoryLimitBytes     BigInt? @map("memory_limit_bytes")
  failureReason       String?  @map("failure_reason")
  endpoint            String?
  metadata            Json?    @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  tasks  Task[]

  @@map("instances")
}

model Project {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  config      String? // models.yaml content
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  tasks  Task[]

  @@map("projects")
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  instanceId  String?   @map("instance_id")
  projectId   String?   @map("project_id")
  title       String
  description String?
  agents      Json      @default("[]")
  status      String    @default("pending")
  result      Json?
  logs        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  instance Instance? @relation(fields: [instanceId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("tasks")
}
